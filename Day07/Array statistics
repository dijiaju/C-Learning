#include <stdio.h>

int main()
{
    int arr[5] = {10,20,30,40,50};

    int max = arr[0];
    int min = arr[0];
    int sum = 0;

    for(int i = 0; i < 5; i++)
    {
        if(arr[i] > max)
        {
            max = arr[i];
        }

        if(arr[i] < min)
        {
            min = arr[i];
        }

        sum += arr[i];
    }

    float avg = (float)sum / 5;

    printf("最大值：%d\n", max);
    printf("最小值：%d\n", min);
    printf("总和：%d\n", sum);
    printf("平均值：%.2f\n", avg);

    return 0;
}
